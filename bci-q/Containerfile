# Start from the official, secure SUSE Python 3.13 Base Container Image
FROM registry.suse.com/bci/python:3.13

# Set the working directory
WORKDIR /app

# Copy requirements file
COPY requirements.txt /app/requirements.txt

# Upgrade pip and install requirements using the container's native Python 3.13
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir --extra-index-url=https://pypi.nvidia.com -r /app/requirements.txt

# Copy test/application files
COPY test_q.py /app/test_q.py

# Configure environment variables to locate precompiled CUDA-Q and CUDA-X shared libraries
ENV LD_LIBRARY_PATH="/usr/local/lib/python3.13/site-packages/nvidia/cublas/lib:\
/usr/local/lib/python3.13/site-packages/nvidia/cuda_runtime/lib:\
/usr/local/lib/python3.13/site-packages/nvidia/cuda_nvrtc/lib:\
/usr/local/lib/python3.13/site-packages/nvidia/curand/lib:\
/usr/local/lib/python3.13/site-packages/nvidia/cusolver/lib:\
/usr/local/lib/python3.13/site-packages/nvidia/cusparse/lib:\
/usr/local/lib/python3.13/site-packages/nvidia/nvjitlink/lib:\
/usr/local/lib/python3.13/site-packages/nvidia/cu13/lib:${LD_LIBRARY_PATH}"

# Default command runs the functional verification test
CMD ["python3", "/app/test_q.py"]
